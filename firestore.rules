rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAllowed() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          "haruki7856th@gmail.com",
          "kaihatuproject8@gmail.com",
          "kaihatu.app01@gmail.com"
        ];
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function tripExists(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId));
    }

    function tripMemberUids(tripId) {
      return tripDoc(tripId).data.memberUids;
    }

    function isTripMember(tripId) {
      return isAllowed()
        && tripExists(tripId)
        && (request.auth.uid in tripMemberUids(tripId));
    }

    function isMember() {
      return isAllowed()
        && (request.auth.uid in resource.data.memberUids);
    }

    function isLastMemberOfTripDoc() {
      return isAllowed()
        && (request.auth.uid in resource.data.memberUids)
        && resource.data.memberUids.size() == 1;
    }

    function isLastMemberOfTrip(tripId) {
      return isAllowed()
        && tripExists(tripId)
        && (request.auth.uid in tripMemberUids(tripId))
        && tripMemberUids(tripId).size() == 1;
    }

    function publicIdUid(pid) {
      return exists(/databases/$(database)/documents/publicIds/$(pid))
        ? get(/databases/$(database)/documents/publicIds/$(pid)).data.uid
        : "";
    }

    function isSelfJoinTrip() {
      return isAllowed()
        && !(request.auth.uid in resource.data.memberUids)
        && (request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function isSelfLeaveTrip() {
      return isAllowed()
        && (request.auth.uid in resource.data.memberUids)
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function isInviteRecipient(inv) {
      return isAllowed()
        && (
          request.auth.uid == inv.toUid
          || request.auth.uid == publicIdUid(inv.toPublicId)
        );
    }

    match /users/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if isAllowed();
      allow create, update, delete: if isAllowed() && request.auth.uid == userId;
    }

    match /publicIds/{pid} {
      allow read: if true;

      allow create: if isAllowed()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAllowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAllowed()
        && resource.data.uid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow get: if isTripMember(tripId);
      allow list: if isMember();

      allow create: if isAllowed()
        && (request.auth.uid in request.resource.data.memberUids);

      allow update: if isAllowed()
        && (
          (
            isMember()
            && request.resource.data.memberUids == resource.data.memberUids
          )
          || isSelfJoinTrip()
          || isSelfLeaveTrip()
        );

      allow delete: if isLastMemberOfTripDoc();

      match /messages/{messageId} {
        allow read: if isTripMember(tripId);

        allow create: if isTripMember(tripId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;

        allow update: if false;

        allow delete: if isLastMemberOfTrip(tripId);
      }
    }

    match /invites/{inviteId} {
      allow read: if isAllowed()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
          || request.auth.uid == publicIdUid(resource.data.toPublicId)
        );

      allow create: if isAllowed()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if false;

      allow delete: if isAllowed()
        && (
          request.auth.uid == resource.data.fromUid
          || isInviteRecipient(resource.data)
        );
    }
  }
}
